# Template file for 'd77run'
# See void/README.md in the d77run repo for how to build this with xbps-src.
pkgname=d77run
version=0.3.0
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="gtk4-devel"
depends="gtk4"
short_desc="Minimal GTK4 run-dialog launcher (a rejuvenation of gmrun), with .desktop icon rendering"
maintainer="Daniel Azevedo <daniazevedo77@gmail.com>"
license="MIT"
homepage="https://github.com/dani-77/d77run"

# Tagged release tarball (v0.3.0 is the first tagged release — earlier
# packaged versions pinned to a raw commit instead). Bump `version` and
# recompute checksum (`./xbps-src pkg d77run` prints the real one on a
# mismatch) whenever you package a newer release.
distfiles="https://github.com/dani-77/d77run/archive/refs/tags/v${version}.tar.gz"
wrksrc="d77run-${version}"

checksum=48fa3ab623e03e02f9af0b3e026e0959352aaa279a74872237a5df3001346203

post_install() {
	vlicense LICENSE
	vinstall assets/d77run.desktop 644 usr/share/applications d77run.desktop
	vinstall assets/d77run-icon.svg 644 usr/share/icons/hicolor/scalable/apps d77run.svg
	vinstall assets/d77run-icon-16.png 644 usr/share/icons/hicolor/16x16/apps d77run.png
	vinstall assets/d77run-icon-32.png 644 usr/share/icons/hicolor/32x32/apps d77run.png
	vinstall assets/d77run-icon-192.png 644 usr/share/icons/hicolor/192x192/apps d77run.png
	vinstall assets/d77run-icon-512.png 644 usr/share/icons/hicolor/512x512/apps d77run.png
}
